static void print_int(int num) {
    if (num == 0) {
        sys_print("0", 1);
        return;
    }

    char buf[20];
    int i = 0;
    int is_negative = 0;

    if (num < 0) {
        is_negative = 1;
        num = -num;
    }

    while (num > 0) {
        buf[i++] = '0' + (num % 10);
        num /= 10;
    }

    if (is_negative) {
        buf[i++] = '-';
    }


    for (int j = 0; j < i / 2; j++) {
        char tmp = buf[j];
        buf[j] = buf[i - j - 1];
        buf[i - j - 1] = tmp;
    }

    sys_print(buf, i);
}

void main_program(int argc, char **argv) {
    for(int i = 0; i < argc; i++) {
        print_str("argv[");
        print_int(i);
        print_str("] = ");
        print_str(argv[i]);
        print_str("\n");
    }
}

